[{{ range $i, $p := where .Site.RegularPages "Type" "posts" }}{{ if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "permalink": {{ $p.RelPermalink | jsonify }},
    "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ $p.Description | default $p.Summary | jsonify }},
    "content": {{ $p.Plain | jsonify }},
    "tags": [{{ range $ti, $t := $p.Params.tags }}{{ if $ti }},{{ end }}{{ $t | jsonify }}{{ end }}]
  }{{ end }}
]